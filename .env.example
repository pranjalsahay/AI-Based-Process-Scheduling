# SchedulAI Configuration
PROJECT_NAME="SchedulAI"
VERSION="1.0.0"
ENVIRONMENT="development"

# LLM Inference (Local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b-instruct-q3_K_M"
LLM_TEMPERATURE=0.2
INFERENCE_TIMEOUT_SECONDS=60.0

# Vector Knowledge Base & RAG
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHROMA_PERSIST_DIRECTORY="./data/chroma"
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=250
TOP_K_RETRIEVAL=5

# Database Persistence
DATABASE_URL="sqlite:///./data/schedulai.db"

# Scheduling Defaults
DEFAULT_ROUND_ROBIN_QUANTUM=2.0
DEFAULT_PRIORITY_CONVENTION="lower_is_higher"
